<html>
<head>
<meta charset="utf-8">
<title>{{nodeName}}</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Trebuchet MS",Arial,Helvetica,sans-serif;background:transparent;color:#000;padding:10px;font-size:12px}
h2{font-size:15px;font-weight:700;color:#003366}.sub{color:#555;font-size:11px;margin:2px 0 8px}
.tabs{display:flex;gap:0;margin-bottom:8px;border-bottom:2px solid #003366}
.tabs button{border:1px solid #808080;border-bottom:none;background:#606060;color:#fff;padding:6px 12px;cursor:pointer;font-family:inherit;font-size:11px;margin-right:2px;border-radius:4px 4px 0 0}
.tabs button.active{background:#003366;border-color:#003366;font-weight:700}
.pane{display:none}.pane.active{display:block}
.panel{background:#fff;border:1px solid #aaa;border-radius:2px;padding:10px;margin-bottom:8px}
.panel-title{background:#c0c0c0;font-size:11px;font-weight:700;padding:4px 7px;margin:-10px -10px 8px -10px;border-bottom:1px solid #aaa}
.ucard{display:flex;gap:10px;align-items:center;background:#f7f8f7;border:1px solid #bbb;border-radius:2px;padding:10px;margin-bottom:6px}
.uav{width:34px;height:34px;border-radius:2px;display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;flex-shrink:0;background:#003366}
.uname{font-weight:700;color:#000;font-size:13px}.udev{color:#555;font-size:11px;margin-top:1px}
.ubadge{display:inline-block;margin-top:3px;font-size:10px;padding:1px 6px;border-radius:2px;background:#ddd;color:#333;font-weight:700}
.online{width:8px;height:8px;border-radius:50%;background:#2e7d32;margin-left:auto}
.toolbar{display:flex;flex-wrap:wrap;gap:5px;align-items:center;margin-bottom:6px}
.toolbar input{font-family:inherit;font-size:11px;border:1px solid #808080;background:#fff;padding:4px 6px}
.btn{font-family:inherit;font-size:11px;border:1px solid #808080;background:#f0f0f0;color:#000;padding:4px 10px;cursor:pointer;border-radius:2px}
.btn-primary{background:#003366;color:#fff;border-color:#002244}
.tbsep{display:inline-block;width:1px;height:20px;background:#bbb;margin:0 6px;vertical-align:middle}
.empty,.loading{text-align:center;padding:24px;color:#666}
.dbg{margin-top:8px;font-size:10px;color:#003366;cursor:pointer;text-decoration:underline}
#debug{display:none;background:#fff8e1;border:1px solid #e0c060;color:#333;padding:5px;margin-top:4px;font-size:9px;font-family:Consolas,monospace;max-height:100px;overflow:auto;white-space:pre-wrap}
.gantt-wrap{overflow:auto;border:1px solid #aaa;background:#fff;position:relative;min-height:50px;max-height:calc(100vh - 280px)}
.gantt-sel{position:absolute;top:0;bottom:0;background:rgba(0,51,102,.18);border:1px solid rgba(0,51,102,.45);pointer-events:none;z-index:6;box-sizing:border-box}
</style>
</head>
<body>
<h2>User Tracer</h2><div class="sub">{{nodeName}}</div>
<div class="panel">
  <div class="panel-title">Período</div>
  <div class="toolbar">
    <button class="btn" data-r="8h" onclick="setRange('8h',this)">8h</button>
    <button class="btn" data-r="today" onclick="setRange('today',this)">Hoje</button>
    <button class="btn" data-r="7d" onclick="setRange('7d',this)">7d</button>
    <button class="btn" data-r="30d" onclick="setRange('30d',this)">30d</button>
    <span class="tbsep"></span>
    <button class="btn" data-r="1h" onclick="setRange('1h',this)">1h</button>
    <button class="btn" data-r="2h" onclick="setRange('2h',this)">2h</button>
    <button class="btn" data-r="4h" onclick="setRange('4h',this)">4h</button>
    <button class="btn" data-r="6h" onclick="setRange('6h',this)">6h</button>
    <span class="tbsep"></span>
    <input type="date" id="dStart" onchange="loadHistory()"><input type="date" id="dEnd" onchange="loadHistory()">
    <button class="btn" id="btnResetZoom" onclick="resetZoom()" title="Resetar zoom" style="display:none;font-weight:700">↺</button><span class="muted" id="tlFilter" style="margin-left:6px"></span>
  </div>
</div>
<div class="panel" style="padding:0;overflow:hidden">
  <div class="panel-title" style="margin:0;display:flex;justify-content:space-between;align-items:center">
    <span>Sessões</span>
    <span style="font-size:10px;color:#666;font-weight:400">Timeline de uso</span>
  </div>
  <div id="gantt"><div class="empty">Selecione o período.</div></div>
</div>
<div class="panel" style="padding:0;overflow:hidden">
  <div class="panel-title" style="margin:0;display:flex;justify-content:space-between;align-items:center">
    <span>Estado agora</span>
    <span style="font-size:10px;color:#666;font-weight:400;display:flex;align-items:center;gap:6px"><span id="liveMeta"></span><button class="btn" onclick="queryLiveState()">↻</button></span>
  </div>
  <div id="liveState"><div class="empty">—</div></div>
</div>
<div class="panel">
  <div class="panel-title">Usuários que já usaram este dispositivo</div>
  <div id="userList"><div class="empty">Selecione o período primeiro.</div></div>
</div>
<div class="dbg" onclick="var d=document.getElementById('debug');d.style.display=d.style.display==='none'?'block':'none'">Debug</div>
<div id="debug">aguardando...</div>
<script>
var D=[], nodeid='{{nodeid}}', nodeName='{{nodeName}}';
var ms=(typeof top!='undefined'&&top.meshserver)||(typeof parent!='undefined'&&parent.meshserver)||window.meshserver;
var _savedEvents=[],_activeUsers={},_activeLusers={},_viewRange=null,_baseRange={rs:0,re:0},_pwrMap=null,_reqSeq=0;
var _unmounted=false; // cleanup marker (#3, #12)
var _wsHandler=null;
// =====================================================================
// Shared utilities (esc, splitUser, ymd, fmtDur, eventMeta, dlog).
// These are byte-identical in admin.handlebars and device.handlebars.
// When modifying, mirror to both files. (No build step — MeshCentral
// upstream does not implement ?include=1 for plugin views; see
// analysis/STUDY-user-online-state.md for the DRY study.)
// =====================================================================
function dlog(){var a=Array.prototype.slice.call(arguments);D.push(new Date().toLocaleTimeString()+' '+a.join(' '));var e=document.getElementById('debug');if(e)e.innerHTML=D.slice(-60).join('\n');}
function eventMeta(t){return{color:t==='userLock'?'#e65100':t==='userLogout'?'#888':'#2e7d32',label:t==='userLock'?'Bloqueado':t==='userLogout'?'Offline':'Online',endLabel:t==='userLogin'?'<b>Agora</b>':t==='userUnlock'?'<b>Agora</b>':null};}
function liveState(nodeid, user){
    var activeU=_activeUsers[nodeid]||[],activeL=_activeLusers[nodeid]||[];
    var uShort=splitUser(user).u||user,matched=false,locked=false;
    for(var i=0;i<activeU.length;i++){var as=splitUser(activeU[i]).u||activeU[i];if(as===uShort||activeU[i]===user){matched=true;break;}}
    if(matched){for(var j=0;j<activeL.length;j++){var ls=splitUser(activeL[j]).u||activeL[j];if(ls===uShort||activeL[j]===user){locked=true;break;}}}
    if(locked)return{color:'#e65100',label:'Bloqueado',endLabel:null};
    if(matched)return{color:'#2e7d32',label:'Online',endLabel:'<b>Agora</b>'};
    return{color:'#888',label:'Offline',endLabel:null};
}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
function splitUser(u){var p=String(u||'').split('\\');return p.length>1?{d:p[0],u:p[1]}:{d:'',u:u||''};}
function ymd(d){var x=new Date(d),m=x.getMonth()+1,day=x.getDate();return x.getFullYear()+'-'+(m<10?'0':'')+m+'-'+(day<10?'0':'')+day;}
function fmtDate(d){var x=new Date(d);return isNaN(x)?'—':x.toLocaleString();}
function fmtDur(ms){if(ms<0)ms=0;var m=Math.floor(ms/60000),h=Math.floor(m/60),d=Math.floor(h/24);m%=60;h%=24;if(d>0)return d+'d '+h+'h';if(h>0)return h+'h '+m+'m';return m+'m';}

function setRange(kind,btn){
    document.querySelectorAll('.btn[data-r]').forEach(function(b){b.classList.remove('active');});
    if(btn)btn.classList.add('active');
    _viewRange=null;
    var btnReset=document.getElementById('btnResetZoom');if(btnReset)btnReset.style.display='none';
    var end=new Date(),start=new Date();
    if(kind==='1h'){start.setTime(end.getTime()-3600000);}
    else if(kind==='2h'){start.setTime(end.getTime()-7200000);}
    else if(kind==='4h'){start.setTime(end.getTime()-14400000);}
    else if(kind==='6h'){start.setTime(end.getTime()-21600000);}
    else if(kind==='8h'){start.setTime(end.getTime()-28800000);}
    else if(kind==='today')start=new Date(end.getFullYear(),end.getMonth(),end.getDate());
    else if(kind==='7d')start.setDate(end.getDate()-6);
    else if(kind==='30d')start.setDate(end.getDate()-29);
    document.getElementById('dStart').value=ymd(start);document.getElementById('dEnd').value=ymd(end);
    loadHistory();
}

// #19 — loadHistory com dedupe e queue
// loadHistory — sem dedupe: _reqSeq já descarta responses stale.
// 100ms debounce via _sendDebounced reduz envios em rajada (date-picker onchange rápido).
var _sendDebounced = {};
function loadHistory(){
    if (_unmounted) return;
    _viewRange=null;
    var btnReset=document.getElementById('btnResetZoom');if(btnReset)btnReset.style.display='none';
    var s=document.getElementById('dStart').value,e=document.getElementById('dEnd').value;
    if(!s||!e){
        document.getElementById('gantt').innerHTML='<div class="empty">Selecione datas.</div>';
        document.getElementById('userList').innerHTML='<div class="empty">Selecione datas.</div>';
        return;
    }
    var key='loadHistory|'+s+'|'+e;
    if (_sendDebounced[key]) return;
    _sendDebounced[key]=true;
    setTimeout(function(){ _sendDebounced[key]=false; }, 100);
    document.getElementById('gantt').innerHTML='<div class="loading">Carregando...</div>';
    if(ms){
        var _s=++_reqSeq;
        ms.send({action:'plugin',plugin:'usertracer',pluginaction:'getTimeline',nodeid:nodeid,startDate:s+'T00:00:00',endDate:e+'T23:59:59.999',limit:2000,_reqSeq:_s});
    }
}
function renderLiveState(d){
    var el=document.getElementById('liveState');if(!el)return;
    var meta=document.getElementById('liveMeta');
    if(d.offline){el.innerHTML='<div class="empty">Agente offline'+(d.timeout?' (timeout)':'')+' — exibindo último estado conhecido na timeline.</div>';if(meta)meta.textContent='';return;}
    var locked=d.locked||[];
    function isLocked(u){var s=splitUser(u).u||u;for(var i=0;i<locked.length;i++){var l=splitUser(locked[i]).u||locked[i];if(l===s||locked[i]===u)return true;}return false;}
    var sess=(d.sessions||[]).filter(function(s){return s.user;});
    if(!sess.length){el.innerHTML='<div class="empty">Nenhuma sessão ativa.</div>';}
    else{
        var h='';
        sess.forEach(function(s){
            var lk=isLocked(s.user);
            var badge=lk?'<span class="ubadge" style="background:#e65100;color:#fff">Bloqueado</span>':'<span class="ubadge" style="background:#2e7d32;color:#fff">Ativo</span>';
            h+='<div class="ucard"><div class="uav">'+esc(splitUser(s.user).u.charAt(0).toUpperCase())+'</div><div><div class="uname">'+esc(s.user)+'</div><div class="udev">sessão '+(s.sid!=null?esc(s.sid):'—')+'</div></div>'+badge+'<div class="online"></div></div>';
        });
        el.innerHTML=h;
    }
    if(meta)meta.textContent='via agente'+(d.journalPending!=null&&d.journalPending>0?' · '+d.journalPending+' eventos pendentes':'')+(d.moduleVer?' · v'+d.moduleVer:'');
}
function queryLiveState(){
    if(_unmounted||!ms)return;
    dlog('LIVE','query sent');
    ms.send({action:'plugin',plugin:'usertracer',pluginaction:'queryState',nodeid:nodeid});
}
function eventSrcBadge(e){
    if(e && e.src==='agent')return'\nOrigem: evento do agente (preciso)';
    if(e && e.src==='scan')return'\nOrigem: varredura (±30s)';
    return'';
}
function buildSessions(events,rs,re){
    var by={};
    events.slice().sort(function(a,b){return new Date(a.detectedAt)-new Date(b.detectedAt);}).forEach(function(e){
        var k=e.displayUser||e.username||'?';if(!by[k])by[k]={user:e.username,display:k,events:[]};by[k].events.push(e);
    });
    var out=[];Object.keys(by).forEach(function(k){
        var g=by[k],activeStart=null,activeState='login',activeSrc=null;
        function pushSeg(s,e,st,open,src){
            var ss=Math.max(rs,s),ee=Math.max(rs,Math.min(re,e));
            if(ee>ss)out.push({user:g.user,display:g.display,start:ss,end:ee,state:st,open:!!open,_srcEvt:src||null});
        }
        g.events.forEach(function(e){
            var t=new Date(e.detectedAt).getTime();
            if(e.eventType==='userLogin'){
                if(activeStart!=null)pushSeg(activeStart,t,activeState,false,activeSrc);
                activeStart=t;activeState='login';activeSrc=e.src;
            }else if(e.eventType==='userLogout'){
                if(activeStart!=null){pushSeg(activeStart,t,activeState,false,activeSrc);activeStart=null;}
                else pushSeg(t-30*60000,t,'logout',false,e.src);
            }else if(e.eventType==='userLock'){
                if(activeStart!=null)pushSeg(activeStart,t,activeState,false,activeSrc);
                activeStart=t;activeState='lock';activeSrc=e.src;
            }else if(e.eventType==='userUnlock'){
                if(activeStart!=null)pushSeg(activeStart,t,activeState,false,activeSrc);
                activeStart=t;activeState='login';activeSrc=e.src;
            }
        });if(activeStart!=null)pushSeg(activeStart,Math.min(re,Date.now()),activeState,true,activeSrc);
    });return out;
}
function _renderGantt(events,rs,re,pwrMap){
    _savedEvents=events;
    var total=re-rs;if(total<=0)total=86400000;
    var sessions=buildSessions(events,rs,re);
    sessions.forEach(function(s){if(s.open){var ls=liveState(nodeid,s.display||s.user||'');if(s.state==='logout')s.state=ls.label==='Offline'?s.state:'login';else if(s.state==='lock'&&ls.label==='Online')s.state='login';}});
    if(!sessions.length){document.getElementById('gantt').innerHTML='<div class="empty">Nenhuma sessão.</div>';return;}
    var dayMs=86400000,span=total/dayMs;
    var step=span<=0.02?60000:(span<=0.08?300000:(span<=0.25?900000:(span<=0.5?1800000:(span<=1?3600000:(span<=7?10800000:(span<=14?21600000:43200000))))));
    var ticks=[],t0=Math.ceil(rs/step)*step;
    for(var t=t0;t<=re;t+=step){var d=new Date(t);ticks.push({pct:((t-rs)/total)*100,label:step<3600000?((d.getHours()<10?'0':'')+d.getHours()+':'+(d.getMinutes()<10?'0':'')+d.getMinutes()):step<dayMs?((d.getHours()<10?'0':'')+d.getHours()+':00'):((d.getDate()<10?'0':'')+d.getDate()+'/'+(d.getMonth()+1<10?'0':'')+(d.getMonth()+1))});}
    var mw=Math.max(520,Math.min(2400,Math.floor(span*100)));
    var h='<div class="gantt-wrap"><div class="gantt-row gantt-head" style="display:flex;border-bottom:1px solid #aaa;background:#e4e9e7;position:sticky;top:0;z-index:2"><div style="width:160px;flex-shrink:0;padding:6px 7px;font-size:9px;color:#333;font-weight:700;border-right:1px solid #aaa">SESSÃO</div><div class="gantt-track" data-rs="'+rs+'" data-re="'+re+'" style="flex:1;position:relative;height:28px;min-width:'+mw+'px">';
    ticks.forEach(function(tk){h+='<div style="position:absolute;top:0;bottom:0;border-left:1px dashed #ccc;left:'+tk.pct+'%"><span style="position:absolute;top:6px;left:3px;font-size:8px;color:#666;white-space:nowrap">'+esc(tk.label)+'</span></div>';});
    h+='</div></div>';
    var byUser={};sessions.forEach(function(s){var k=s.display||s.user||'?';if(!byUser[k])byUser[k]=[];byUser[k].push(s);});
    var users=Object.keys(byUser).sort();if(!users.length)users=['—'];
    users.forEach(function(u){
        var segs=byUser[u]||[];if(!segs.length)return;
        segs.sort(function(a,b){return a.start-b.start;});
        var fst=segs[0],lst=segs[segs.length-1];
        var barStart=Math.max(fst.start,rs),barEnd=Math.min(lst.end,re);
        var barLeft=Math.max(0,((fst.start-rs)/total)*100),barRight=Math.min(100,((lst.end-rs)/total)*100);if(barRight<=barLeft)barRight=barLeft+0.15;
        var barW=barRight-barLeft,barMs=barEnd-barStart||1;
        h+='<div class="gantt-row" style="display:flex;min-height:40px;border-bottom:1px solid #e0e0e0"><div style="width:160px;flex-shrink:0;padding:7px;border-right:1px solid #ccc;font-size:10px;color:#003366;font-weight:700;display:flex;align-items:center;background:#fff">'+esc(u)+'</div><div class="gantt-track" data-rs="'+rs+'" data-re="'+re+'" style="flex:1;position:relative;min-width:'+mw+'px;min-height:40px">';
        ticks.forEach(function(tk){h+='<div style="position:absolute;top:0;bottom:0;border-left:1px dashed #ccc;left:'+tk.pct+'%"></div>';});
        var stColor = {'login':'#2e7d32','lock':'#e65100','logout':'#888'};
        h+='<div style="position:absolute;top:9px;height:20px;left:'+barLeft+'%;width:'+barW+'%;border-radius:2px;overflow:hidden;border:1px solid rgba(0,0,0,.2)">';
        segs.forEach(function(s,i){
            var visStart=Math.max(s.start,barStart),visEnd=Math.min(s.end,barEnd);
            var visDur=Math.max(0,visEnd-visStart);
            var sPct=Math.max(0.5,(visDur/barMs)*100);
            var sLeft=((visStart-barStart)/barMs)*100;
            var em=eventMeta(s.state==='lock'?'userLock':s.state==='login'?'userLogin':'userLogout');
            var bg = stColor[s.state] || '#2e7d32';
            var tt='Usuário: '+esc(s.user||s.display)+'\nDe: '+fmtDate(s.start)+'\nAté: '+fmtDate(s.end)+'\nEstado: '+em.label+'\nDuração: '+fmtDur(s.end-s.start)+eventSrcBadge(s._srcEvt);
            h+='<div style="position:absolute;top:0;height:100%;left:'+sLeft+'%;width:'+sPct+'%;min-width:4px;background:'+bg+';border-right:1px solid rgba(0,0,0,.15);cursor:zoom-in" title="'+esc(tt)+'"></div>';
        });
        h+='<span style="position:absolute;top:1px;left:3px;font-size:8px;font-weight:700;color:#fff;text-shadow:0 0 2px rgba(0,0,0,.6);pointer-events:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:calc(100% - 6px)" title="'+esc(segs[0].user||'')+'">'+esc(segs[0].user||'')+'</span>';
        h+='</div></div></div>';
    });
    h+='</div>';document.getElementById('gantt').innerHTML=h;
    if(!_viewRange){_baseRange={rs:rs,re:re};}setViewHint();setupGanttDrag();
    var byName={};events.forEach(function(e){var k=e.displayUser||e.username||'?';if(!byName[k])byName[k]={user:k,username:e.username,domain:e.domain||'',events:[]};byName[k].events.push(e);});
    var names=Object.keys(byName).sort();
    if(!names.length){document.getElementById('userList').innerHTML='<div class="empty">Nenhum usuário.</div>';return;}
    var ul='<table class="tbl" style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr style="background:#aaa;color:#000;font-weight:700;text-align:left"><th style="padding:5px 7px;border:1px solid #999">Usuário</th><th style="padding:5px 7px;border:1px solid #999">Domínio</th><th style="padding:5px 7px;border:1px solid #999">Eventos</th><th style="padding:5px 7px;border:1px solid #999">Primeiro</th><th style="padding:5px 7px;border:1px solid #999">Último</th><th style="padding:5px 7px;border:1px solid #999">Status</th></tr></thead><tbody>';
    var devOff = pwrMap && pwrMap[nodeid] && pwrMap[nodeid].pwr === 0;
    names.forEach(function(k){var g=byName[k],evs=g.events.sort(function(a,b){return new Date(b.detectedAt)-new Date(a.detectedAt);});var last=evs[0],first=evs[evs.length-1];
    var em = devOff ? {color:'#888',label:'Offline',endLabel:null} : liveState(nodeid, g.username||g.user);
    var endLab = em.endLabel || fmtDate(last.detectedAt);
    ul+='<tr><td style="padding:5px 7px;border-bottom:1px solid #ddd"><b>'+esc(g.username||g.user)+'</b></td><td style="padding:5px 7px;border-bottom:1px solid #ddd;color:#555;font-size:11px">'+esc(g.domain||'—')+'</td><td style="padding:5px 7px;border-bottom:1px solid #ddd">'+evs.length+'</td><td style="padding:5px 7px;border-bottom:1px solid #ddd;color:#555;font-size:11px">'+esc(fmtDate(first.detectedAt))+'</td><td style="padding:5px 7px;border-bottom:1px solid #ddd;color:#555;font-size:11px">'+endLab+'</td><td style="padding:5px 7px;border-bottom:1px solid #ddd;font-weight:700;color:'+em.color+'">'+em.label+'</td></tr>';});
    ul+='</tbody></table>';document.getElementById('userList').innerHTML=ul;
}
function renderGantt(events,pwrMap){
    events=events||[];_pwrMap=pwrMap;
    if(!events.length){document.getElementById('gantt').innerHTML='<div class="empty">Nenhum evento no período.</div>';document.getElementById('userList').innerHTML='<div class="empty">Nenhum evento.</div>';return;}
    var ds=document.getElementById('dStart'),de=document.getElementById('dEnd');
    var rs=new Date(ds.value+'T00:00:00').getTime(),re=new Date(de.value+'T23:59:59.999').getTime();
    if(isNaN(rs)||isNaN(re)||re<=rs){
        rs=Infinity;re=-Infinity;events.forEach(function(e){var t=new Date(e.detectedAt).getTime();if(t<rs)rs=t;if(t>re)re=t;});if(re<=rs)re=rs+86400000;
    }
    _baseRange={rs:rs,re:re};
    if(_viewRange&&_viewRange.re>_viewRange.rs){rs=_viewRange.rs;re=_viewRange.re;}
    try{_renderGantt(events,rs,re,pwrMap);}catch(ex){dlog('RGERR',ex.message);}
}


// === Drag-to-zoom (portado de admin.handlebars) ===
function activeRange(){ if(_viewRange&&_viewRange.re>_viewRange.rs)return _viewRange; return _baseRange.rs?_baseRange:{rs:0,re:86400000}; }
function setViewHint(){
    var el=document.getElementById('tlFilter');if(!el)return;
    if(!_viewRange){el.textContent='';return;}
    el.textContent=fmtDate(_viewRange.rs)+' → '+fmtDate(_viewRange.re)+' ('+fmtDur(_viewRange.re-_viewRange.rs)+')';
    var btn=document.getElementById('btnResetZoom');if(btn)btn.style.display='';
}
function zoomTo(rs,re){
    rs=Math.floor(rs);re=Math.ceil(re);
    if(!(re>rs))return;
    if(re-rs<60000){var mid=(rs+re)/2;rs=mid-30000;re=mid+30000;}
    _viewRange={rs:rs,re:re};setViewHint();
    if(!_savedEvents.length){return;}
    _renderGantt(_savedEvents,rs,re,_pwrMap);
}
function resetZoom(){
    if(!_savedEvents.length){_viewRange=null;var btn=document.getElementById('btnResetZoom');if(btn)btn.style.display='none';return;}
    _viewRange=null;
    var rs=_baseRange.rs,re=_baseRange.re;
    setViewHint();
    _renderGantt(_savedEvents,rs,re,_pwrMap);
}
function setupGanttDrag(){
    var wrap=document.querySelector('.gantt-wrap');if(!wrap)return;
    var drag=null;
    function trackOf(el){while(el&&el!==wrap){if(el.classList&&el.classList.contains('gantt-track'))return el;el=el.parentNode;}return wrap.querySelector('.gantt-track');}
    function timeAt(track,clientX){if(!track)return 0;var rs=+track.getAttribute('data-rs'),re=+track.getAttribute('data-re');var rect=track.getBoundingClientRect();var w=rect.width;if(w<=0)return rs;var x=clientX-rect.left;if(x<0)x=0;if(x>w)x=w;return rs+(x/w)*(re-rs);}
    function pxAt(track,clientX){if(!track)return 0;var rect=track.getBoundingClientRect();var w=rect.width;if(w<=0)return 0;var x=clientX-rect.left;if(x<0)x=0;if(x>w)x=w;return x;}
    function onMove(e){if(!drag)return;drag.t1=timeAt(drag.track,e.clientX);drag.x1=pxAt(drag.track,e.clientX);var a=Math.min(drag.x0,drag.x1),b=Math.max(drag.x0,drag.x1);if(drag.ov){drag.ov.style.left=a+'px';drag.ov.style.width=Math.max(1,b-a)+'px';}}
    function onUp(e){document.removeEventListener('mousemove',onMove,true);document.removeEventListener('mouseup',onUp,true);if(!drag)return;if(e){drag.t1=timeAt(drag.track,e.clientX);}var t0=Math.min(drag.t0,drag.t1),t1=Math.max(drag.t0,drag.t1);if(drag.ov&&drag.ov.parentNode)drag.ov.parentNode.removeChild(drag.ov);var d=drag;drag=null;if(t1-t0<30000)return;zoomTo(t0,t1);}
    wrap.addEventListener('mousedown',function(e){
        if(e.button!==0)return;
        var t=e.target,onLab=false;
        while(t&&t!==wrap){if(t.classList&&t.classList.contains('gantt-lab')){onLab=true;break;}t=t.parentNode;}
        if(onLab)return;
        var track=trackOf(e.target);if(!track)return;
        var x=pxAt(track,e.clientX);
        var ov=document.createElement('div');ov.className='gantt-sel';ov.style.left=x+'px';ov.style.width='1px';
        track.appendChild(ov);
        drag={track:track,t0:timeAt(track,e.clientX),t1:timeAt(track,e.clientX),x0:x,x1:x,ov:ov};
        document.addEventListener('mousemove',onMove,true);
        document.addEventListener('mouseup',onUp,true);
    });
}
// #2 — handler único

(function(){
    if (_unmounted) return;
    if (ms && ms.socket) {
        _wsHandler = function(e){
            try{
                var d = JSON.parse(e.data);
                if (d.action === 'plugin' && d.plugin === 'usertracer' && d.method === 'timeline') {
                    // Stale check via _reqSeq (response must match latest send).
                    if (d._reqSeq != null && d._reqSeq !== _reqSeq) { dlog('WS_TL_STALE','seq='+d._reqSeq+' expected='+_reqSeq); return; }
                    dlog('WS','got timeline n=' + (d.data?d.data.length:'?'));
                    if (d._activeUsers && typeof d._activeUsers === 'object') _activeUsers = d._activeUsers;
                    if (d._activeLusers && typeof d._activeLusers === 'object') _activeLusers = d._activeLusers;
                    renderGantt(d.data || [], d._pwrMap);
                }
                if (d.action === 'plugin' && d.plugin === 'usertracer' && d.method === 'liveState') {
                    dlog('WS','got liveState offline=' + d.offline);
                    renderLiveState(d);
                }
            } catch (ex) { dlog('WSE', ex.message); }
        };
        try { ms.socket.addEventListener('message', _wsHandler); dlog('WS','installed'); }
        catch (ex) { ms.socket.onmessage = _wsHandler; }
    } else { dlog('WS','no socket'); }
    // #12 - cleanup
    window.addEventListener('beforeunload', function () {
        _unmounted = true;
        if (ms && ms.socket && _wsHandler) {
            try { ms.socket.removeEventListener('message', _wsHandler); } catch (_) {}
        }
        _wsHandler = null;
    });
    window.addEventListener('unload', function () {
        _unmounted = true;
        if (ms && ms.socket && _wsHandler) {
            try { ms.socket.removeEventListener('message', _wsHandler); } catch (_) {}
        }
    });
})();
setRange('8h',document.querySelector('.btn[data-r="8h"]'));
loadHistory();
queryLiveState();
setInterval(function(){ if(!_unmounted)queryLiveState(); },60000);
</script>
